{
  "name": "@localkart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate": "node ../../scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx --env-file=../../.env ../../database/seeds/seed.ts",
    "test": "vitest run",
    "db:seed-images": "tsx --env-file=../../.env ../../database/seeds/images.ts"
  },
  "dependencies": {
    "@localkart/shared": "*",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "expo-server-sdk": "^4.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.5",
    "socket.io": "4.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "vitest": "4.1.12"
  }
}
