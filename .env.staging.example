NODE_ENV=production
DATABASE_URL=
# Optional direct/session-mode connection for migrations (never transaction pooling).
MIGRATION_DATABASE_URL=
JWT_SECRET=
PICKUP_SECRET=
CORS_ORIGINS=https://your-staging-admin.example
ENABLE_EXPO_PUSH=true
EXPO_CUSTOMER_PROJECT_ID=
EXPO_MERCHANT_PROJECT_ID=
EXPO_ACCESS_TOKEN=
ENABLE_SIMULATED_PAYMENTS=false
ENABLE_MANUAL_DELIVERY=false
BARCODE_CATALOG_PROVIDER=none
UPLOAD_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server key fallback; prefer SUPABASE_SECRET_KEY for new projects.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Public client configuration: set the same URL in both EAS projects and admin build.
EXPO_PUBLIC_API_URL=
VITE_API_URL=
