NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://localkart:local-development-only@localhost:5432/localkart
JWT_SECRET=replace-with-at-least-32-random-characters
PICKUP_SECRET=replace-with-a-different-32-character-secret
CORS_ORIGINS=http://localhost:5173
ENABLE_SIMULATED_PAYMENTS=false
ENABLE_MANUAL_DELIVERY=false
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Push remains disabled until physical-device credentials are configured.
ENABLE_EXPO_PUSH=false
EXPO_ACCESS_TOKEN=
EXPO_CUSTOMER_PROJECT_ID=
EXPO_MERCHANT_PROJECT_ID=
# Native build only: path to Firebase client config (never a service-account key).
GOOGLE_SERVICES_JSON=
LOCALKART_TEST_DEVICE=false
UPLOAD_DRIVER=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Optional food metadata catalog. No provider covers all retail barcodes.
BARCODE_CATALOG_PROVIDER=none
